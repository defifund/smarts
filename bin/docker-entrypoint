#!/bin/bash -e

# If running the rails server then create or migrate existing database, and
# sync the chain registry. Chains::Seeder is idempotent (find_or_initialize_by
# + update!), so running on every boot keeps every replica in sync with the
# canonical list in db/seeds/chains.rb without a per-chain data migration.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  ./bin/rails runner "Chains::Seeder.call"
fi

exec "${@}"
