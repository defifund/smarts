<% seo_meta title: "Create account", description: "Create a Smarts account for article publishing." %>

<div class="mx-auto max-w-md py-16">
  <h1 class="text-3xl font-bold tracking-tight text-gray-950">Create account</h1>
  <p class="mt-3 text-sm leading-6 text-gray-600">Create a Smarts account for MCP article publishing.</p>

  <%= form_with model: @user, url: users_path, class: "mt-8 space-y-5" do |form| %>
    <% if @user.errors.any? %>
      <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        <p class="font-semibold">Could not create account</p>
        <ul class="mt-2 list-disc pl-5">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-800" %>
      <%= form.text_field :name, required: true, autofocus: true, class: "mt-2 w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-950 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100" %>
    </div>

    <div>
      <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-gray-800" %>
      <%= form.email_field :email_address, required: true, autocomplete: "email", class: "mt-2 w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-950 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100" %>
    </div>

    <div>
      <%= form.label :password, class: "block text-sm font-medium text-gray-800" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", class: "mt-2 w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-950 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-gray-800" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "mt-2 w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-950 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100" %>
    </div>

    <%= form.submit "Create account", class: "w-full rounded-xl bg-gray-950 px-4 py-3 font-semibold text-white hover:bg-gray-800" %>
  <% end %>

  <p class="mt-6 text-sm text-gray-600">
    Already have an account?
    <%= link_to "Sign in", new_session_path, class: "font-medium text-blue-700 underline underline-offset-4" %>
  </p>
</div>
