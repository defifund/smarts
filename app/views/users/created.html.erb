<% seo_meta title: "Account created", description: "Your Smarts publishing token has been created." %>

<% endpoint_url = mcp_endpoint_url %>
<% claude_code_cmd = <<~CMD.strip
  claude mcp add --scope user --transport http smarts \\
    #{endpoint_url} \\
    --header "Authorization: Bearer #{@api_token}"
CMD
%>
<% codex_cmd = <<~CMD.strip
  export SMARTS_PUBLISH_TOKEN=#{@api_token}
  codex mcp add smarts \\
    --url #{endpoint_url} \\
    --bearer-token-env-var SMARTS_PUBLISH_TOKEN
CMD
%>
<% ampcode_cmd = <<~CMD.strip
  amp mcp add smarts \\
    --header "Authorization=Bearer #{@api_token}" \\
    #{endpoint_url}
CMD
%>

<div class="mx-auto max-w-4xl py-16">
  <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gray-500">Account created</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-950">Save this publishing token</h1>
    <p class="mt-3 text-gray-600">This token is shown once. The setup commands below already embed it as an <code class="rounded bg-gray-100 px-1.5 py-0.5">Authorization: Bearer</code> header — once your agent is connected, calling <code class="rounded bg-gray-100 px-1.5 py-0.5">validate_article_draft</code> or <code class="rounded bg-gray-100 px-1.5 py-0.5">publish_article</code> needs no further auth arguments.</p>

    <pre class="mt-6 overflow-x-auto rounded-2xl bg-gray-950 p-5 text-sm text-gray-100"><code><%= @api_token %></code></pre>

    <p class="mt-6 text-sm text-gray-500">The database stores only a BCrypt digest, not this plain token.</p>
  </div>

  <section class="mt-8 rounded-3xl border border-gray-200 bg-white p-8 shadow-sm">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gray-500">Connect MCP</p>
    <h2 class="mt-4 text-2xl font-bold tracking-tight text-gray-950">Add Smarts to your coding agent</h2>
    <p class="mt-3 text-gray-600">Each command below registers <code class="rounded bg-gray-100 px-1.5 py-0.5">smarts</code> as a remote MCP server with your token baked into the connection.</p>

    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
      <div class="rounded-2xl border border-gray-200 p-4">
        <div class="mb-3 flex items-baseline justify-between gap-3">
          <h3 class="font-bold text-gray-950">Claude Code</h3>
          <span class="text-xs font-mono text-gray-500">CLI</span>
        </div>
        <pre class="overflow-x-auto rounded-xl bg-gray-950 p-4 text-xs leading-6 text-gray-100"><code><%= claude_code_cmd %></code></pre>
      </div>

      <div class="rounded-2xl border border-gray-200 p-4">
        <div class="mb-3 flex items-baseline justify-between gap-3">
          <h3 class="font-bold text-gray-950">Codex</h3>
          <span class="text-xs font-mono text-gray-500">CLI</span>
        </div>
        <pre class="overflow-x-auto rounded-xl bg-gray-950 p-4 text-xs leading-6 text-gray-100"><code><%= codex_cmd %></code></pre>
      </div>

      <div class="rounded-2xl border border-gray-200 p-4">
        <div class="mb-3 flex items-baseline justify-between gap-3">
          <h3 class="font-bold text-gray-950">Ampcode</h3>
          <span class="text-xs font-mono text-gray-500">CLI</span>
        </div>
        <pre class="overflow-x-auto rounded-xl bg-gray-950 p-4 text-xs leading-6 text-gray-100"><code><%= ampcode_cmd %></code></pre>
      </div>
    </div>
  </section>
</div>
