<% seo_meta title: "Edit article #{@article.slug}", description: "Edit article metadata and publication status." %>

<section class="py-10 sm:py-14">
  <div class="mb-8">
    <%= link_to "← Back to articles", admin_articles_path, class: "text-sm font-semibold text-gray-600 underline underline-offset-4 hover:text-gray-950" %>
    <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-gray-950">Edit <span class="font-mono"><%= @article.slug %></span></h1>
    <p class="mt-3 text-gray-600">Update metadata, localized content, and publication status.</p>
  </div>

  <% if @article.errors.any? %>
    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <p class="font-semibold">Could not save article:</p>
      <ul class="mt-2 list-disc pl-5">
        <% @article.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: [:admin, @article], class: "space-y-8" do |form| %>
    <div class="grid gap-5 rounded-2xl border border-gray-200 bg-white p-5 sm:grid-cols-2">
      <div>
        <%= form.label :slug, class: "block text-sm font-semibold text-gray-900" %>
        <%= form.text_field :slug, class: "mt-2 w-full rounded-lg border border-gray-300 px-3 py-2 font-mono text-sm" %>
      </div>

      <div>
        <%= form.label :publication_status, "Status", class: "block text-sm font-semibold text-gray-900" %>
        <%= form.select :publication_status, options_for_select([["Draft", "draft"], ["Scheduled", "scheduled"], ["Published", "published"]], @article.publication_status), {}, class: "mt-2 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= form.label :category, class: "block text-sm font-semibold text-gray-900" %>
        <%= form.select :category, options_for_select(Article::CATEGORIES, @article.category), {}, class: "mt-2 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= form.label :subcategory, class: "block text-sm font-semibold text-gray-900" %>
        <%= form.text_field :subcategory, class: "mt-2 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm", placeholder: "examples, mcp, infrastructure..." %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :published_at, "Published at", class: "block text-sm font-semibold text-gray-900" %>
        <%= form.datetime_field :published_at, value: @article.published_at&.strftime("%Y-%m-%dT%H:%M"), class: "mt-2 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
        <p class="mt-2 text-xs text-gray-500">Draft clears this value. Published uses now if empty. Scheduled requires a future time to stay scheduled.</p>
      </div>
    </div>

    <% Article::SUPPORTED_LOCALES.each do |locale| %>
      <fieldset class="rounded-2xl border border-gray-200 bg-white p-5">
        <legend class="px-1 text-sm font-bold uppercase tracking-wide text-gray-500"><%= locale %></legend>

        <div class="mt-4 space-y-5">
          <div>
            <%= label_tag "article_title_#{locale}", "Title", class: "block text-sm font-semibold text-gray-900" %>
            <%= text_field_tag "article[title][#{locale}]", @article.title.to_h[locale], class: "mt-2 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
          </div>

          <div>
            <%= label_tag "article_summary_#{locale}", "Summary", class: "block text-sm font-semibold text-gray-900" %>
            <%= text_area_tag "article[summary][#{locale}]", @article.summary.to_h[locale], rows: 3, class: "mt-2 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
          </div>

          <div>
            <%= label_tag "article_content_#{locale}", "Content", class: "block text-sm font-semibold text-gray-900" %>
            <%= text_area_tag "article[content][#{locale}]", @article.content.to_h[locale], rows: 16, class: "mt-2 w-full rounded-lg border border-gray-300 px-3 py-2 font-mono text-sm" %>
          </div>
        </div>
      </fieldset>
    <% end %>

    <div class="flex items-center gap-3">
      <%= form.submit "Save article", class: "rounded-lg bg-gray-950 px-5 py-2.5 text-sm font-semibold text-white hover:bg-gray-800" %>
      <%= link_to "Cancel", admin_articles_path, class: "text-sm font-semibold text-gray-600 hover:text-gray-950" %>
    </div>
  <% end %>
</section>
