<% content_for :body_class, "overflow-x-hidden bg-slate-950 text-slate-100" %>
<% content_for :nav_class, "border-b border-white/10 bg-transparent px-3 py-4 sm:px-5" %>
<% content_for :brand_class, "text-xl font-bold text-white hover:text-slate-200" %>
<% content_for :nav_link_class, "flex items-center gap-4 text-sm font-medium text-slate-300" %>
<% content_for :nav_link_item_class, "hover:text-white" %>
<% content_for :footer_class, "container mx-auto mt-12 border-t border-white/10 px-3 py-8 sm:px-5" %>
<% content_for :footer_text_class, "text-xs text-slate-400" %>
<% content_for :footer_link_class, "text-slate-300 underline hover:text-white" %>

<% seo_title = @page_scope == "testnets" ? t("chains.index.testnets_seo_title") : t("chains.index.seo_title") %>
<% seo_description = @page_scope == "testnets" ? t("chains.index.testnets_seo_description") : t("chains.index.seo_description") %>
<% seo_meta title: seo_title, description: seo_description %>
<% index_base_path = @page_scope == "testnets" ? public_testnets_path : public_chains_index_path %>

<% content_for :head do %>
  <%= render_json_ld(Seo::JsonLd.item_list(
    name: t("chains.index.json_ld_name"),
    description: t("chains.index.json_ld_description"),
    items: @chains.map { |chain| { name: chain.name, url: "#{SeoHelper::SITE_URL}#{public_chain_path(chain.slug)}" } }
  )) %>
<% end %>

<div class="-mx-3 relative isolate overflow-hidden sm:-mx-5">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_10%,rgba(56,189,248,0.16),transparent_24%),radial-gradient(circle_at_80%_20%,rgba(16,185,129,0.12),transparent_22%),linear-gradient(180deg,#09111f_0%,#07101a_48%,#050b14_100%)]"></div>
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(rgba(148,163,184,0.08)_1px,transparent_1px),linear-gradient(90deg,rgba(148,163,184,0.08)_1px,transparent_1px)] bg-[size:5rem_5rem] opacity-15"></div>

  <div class="mx-auto w-full max-w-7xl px-4 pb-14 pt-10 sm:px-8 lg:px-10">
    <section class="grid gap-8 lg:grid-cols-[1.08fr_0.92fr] lg:items-start">
      <div class="space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-sky-400/20 bg-sky-400/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.3em] text-sky-200">
          <%= @page_scope == "testnets" ? t("chains.index.testnets_badge") : t("chains.index.badge") %>
        </div>
        <div>
          <h1 class="text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl">
            <%= @page_scope == "testnets" ? t("chains.index.testnets_heading") : t("chains.index.heading") %>
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300 sm:text-lg">
            <%= @page_scope == "testnets" ? t("chains.index.testnets_description") : t("chains.index.description") %>
          </p>
        </div>

        <div class="rounded-[2rem] border border-white/10 bg-white/5 p-5 shadow-2xl shadow-slate-950/20 backdrop-blur">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-xs font-semibold uppercase tracking-[0.35em] text-slate-400"><%= t("chains.index.filter_network_label") %></p>
            <p class="text-xs text-slate-500"><%= t("chains.index.search_hint") %></p>
          </div>

          <% if @page_scope == "testnets" %>
            <div class="mt-4 rounded-2xl border border-white/10 bg-slate-950/55 p-4">
              <div class="flex flex-wrap items-center gap-2">
                <% [
                  t("chains.index.testnet_guide_rpc"),
                  t("chains.index.testnet_guide_explorer"),
                  t("chains.index.testnet_guide_faucet"),
                  t("chains.index.testnet_guide_verify")
                ].each do |label| %>
                  <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold uppercase tracking-[0.25em] text-slate-200"><%= label %></span>
                <% end %>
              </div>
              <p class="mt-3 text-sm leading-6 text-slate-300"><%= t("chains.index.testnet_guide_description") %></p>
            </div>
          <% else %>
            <div class="mt-4 flex flex-wrap gap-2">
              <% [
                [t("chains.index.filter_all_networks"), public_chains_index_path(q: @query, tier: @tier_filter, network: "all"), @network_filter == "all", @chains.length],
                [t("chains.index.filter_mainnets"), public_chains_index_path(q: @query, tier: @tier_filter, network: "mainnet"), @network_filter == "mainnet", @mainnet_chains.length],
                [t("chains.index.filter_testnets"), public_testnets_path(q: @query, tier: @tier_filter), @network_filter == "testnet", @testnet_chains.length]
              ].each do |label, path, active, count| %>
                <a href="<%= path %>" class="<%= active ? 'border-sky-400/40 bg-sky-400/15 text-sky-100 shadow-lg shadow-sky-950/10' : 'border-white/10 bg-white/5 text-slate-300 hover:bg-white/10' %> inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-semibold transition-colors">
                  <span><%= label %></span>
                  <span class="<%= active ? 'bg-sky-400/20 text-sky-100' : 'bg-white/10 text-slate-400' %> rounded-full px-2 py-0.5 text-[11px] font-medium tabular-nums">
                    <%= count %>
                  </span>
                </a>
              <% end %>
            </div>
          <% end %>

          <%= form_with url: index_base_path, method: :get, local: true, class: "mt-5 grid gap-3" do %>
            <%= hidden_field_tag :network, @network_filter if @network_filter != "all" %>
            <div class="grid gap-3 md:grid-cols-[1.2fr_0.8fr_auto]">
              <div>
                <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.3em] text-slate-400" for="chains_q">
                  <%= t("chains.index.search_label") %>
                </label>
                <input
                  id="chains_q"
                  type="search"
                  name="q"
                  value="<%= @query %>"
                  placeholder="<%= t("chains.index.search_placeholder") %>"
                  class="w-full rounded-2xl border border-white/10 bg-slate-950/80 px-4 py-4 text-base text-white placeholder:text-slate-500 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400/40"
                >
              </div>

              <div>
                <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.3em] text-slate-400" for="chains_tier">
                  <%= t("chains.index.filter_label") %>
                </label>
                <select
                  id="chains_tier"
                  name="tier"
                  class="w-full cursor-pointer rounded-2xl border border-white/10 bg-slate-950/80 px-4 py-4 text-base text-white focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400/40"
                >
                  <option value="all" <%= "selected" if @tier_filter == "all" %>><%= t("chains.index.filter_all") %></option>
                  <option value="full" <%= "selected" if @tier_filter == "full" %>><%= t("chains.index.filter_live") %></option>
                  <option value="docs_only" <%= "selected" if @tier_filter == "docs_only" %>><%= t("chains.index.filter_docs_only") %></option>
                </select>
              </div>

              <div class="flex items-end gap-2">
                <button
                  type="submit"
                  class="w-full rounded-2xl bg-sky-400 px-5 py-4 text-base font-semibold text-slate-950 transition-colors hover:bg-sky-300 cursor-pointer"
                >
                  <%= t("chains.index.search_submit") %>
                </button>
                <% if @query.present? || @tier_filter != "all" %>
                  <a href="<%= index_base_path %>" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-4 text-sm font-semibold text-slate-200 transition-colors hover:bg-white/10">
                    <%= t("chains.index.clear") %>
                  </a>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="rounded-[2rem] border border-white/10 bg-slate-900/70 p-5 shadow-2xl shadow-slate-950/20">
        <div class="grid gap-3 <%= @page_scope == "testnets" ? 'mt-4 sm:grid-cols-1' : 'sm:grid-cols-3' %>">
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
            <p class="text-[10px] uppercase tracking-[0.35em] text-slate-500"><%= t("chains.index.stat_visible") %></p>
            <p class="mt-2 text-3xl font-black text-white"><%= @chains.length %></p>
          </div>
          <% unless @page_scope == "testnets" %>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <p class="text-[10px] uppercase tracking-[0.35em] text-slate-500"><%= t("chains.index.stat_split") %></p>
              <p class="mt-2 text-3xl font-black text-white"><%= @full_chains.length %><span class="text-slate-500"> / </span><%= @docs_only_chains.length %></p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <p class="text-[10px] uppercase tracking-[0.35em] text-slate-500"><%= t("chains.index.stat_network_split") %></p>
              <p class="mt-2 text-3xl font-black text-white"><%= @mainnet_chains.length %><span class="text-slate-500"> / </span><%= @testnet_chains.length %></p>
            </div>
          <% end %>
        </div>

        <% unless @page_scope == "testnets" %>
          <div class="mt-4 rounded-2xl border border-white/10 bg-white/5 p-4">
            <div class="flex items-center justify-between gap-3">
              <p class="text-xs font-semibold uppercase tracking-[0.35em] text-slate-400"><%= t("chains.index.directory_snapshot") %></p>
              <p class="text-xs text-slate-500"><%= t("chains.index.network_focus") %></p>
            </div>
            <div class="mt-3 flex flex-wrap gap-2">
              <% @top_kinds.each do |kind, count| %>
                <span class="rounded-full border border-white/10 bg-slate-950/60 px-3 py-1 text-xs text-slate-200"><%= kind %> <%= count %></span>
              <% end %>
            </div>
            <p class="mt-3 text-sm leading-6 text-slate-400">
              <%= t("chains.index.description") %>
            </p>
          </div>
        <% else %>
          <div class="mt-4 rounded-2xl border border-white/10 bg-white/5 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.35em] text-slate-400"><%= t("chains.index.testnets_section_heading") %></p>
            <p class="mt-2 text-sm leading-6 text-slate-300"><%= t("chains.index.testnets_section_subtitle") %></p>
          </div>
        <% end %>
      </div>
    </section>

    <% if @page_scope == "testnets" %>
      <section class="mt-12">
        <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-[0.35em] text-sky-200"><%= t("chains.index.testnets_section_heading") %></h2>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400"><%= t("chains.index.testnets_section_subtitle") %></p>
          </div>
          <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs text-slate-400">
            <%= @testnet_chains.length %> <%= t("chains.index.stat_visible") %>
          </div>
        </div>

        <% if @chains.any? %>
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            <% @chains.each do |chain| %>
              <div class="group relative overflow-hidden rounded-[1.75rem] border border-white/10 bg-slate-900/75 p-5 shadow-xl shadow-slate-950/20 transition-all hover:-translate-y-0.5 hover:border-sky-400/40 hover:bg-slate-900/90">
                <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-sky-400/80 via-cyan-400/60 to-emerald-400/30 opacity-90"></div>

                <div class="flex items-start justify-between gap-4">
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.3em] text-slate-300">
                        <%= t("chains.index.testnet_pill") %>
                      </span>
                      <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.3em] text-slate-300">
                        <%= chain.full? ? t("chains.index.live_pill") : t("chains.index.docs_pill") %>
                      </span>
                    </div>

                    <h3 class="mt-3 text-xl font-bold text-white transition-colors group-hover:text-sky-300">
                      <a href="<%= public_chain_path(chain.slug) %>" class="hover:text-sky-300"><%= chain.name %></a>
                    </h3>
                    <p class="mt-2 text-sm leading-6 text-slate-400"><%= chain.summary %></p>
                  </div>
                </div>

                <div class="mt-5 grid grid-cols-1 gap-3">
                  <div class="rounded-2xl border border-white/10 bg-white/5 p-3">
                    <p class="text-[10px] uppercase tracking-[0.3em] text-slate-500"><%= t("chains.index.metric_chain_id") %></p>
                    <p class="mt-2 font-mono text-lg text-white"><%= chain.chain_id %></p>
                  </div>
                </div>

                <div class="mt-4 flex flex-wrap gap-2">
                  <% chain.top_kinds(3).each do |kind, count| %>
                    <span class="rounded-full border border-white/10 bg-slate-950/60 px-3 py-1 text-xs text-slate-200"><%= kind %> <%= count %></span>
                  <% end %>
                </div>

                <div class="mt-4 flex flex-wrap gap-2 text-xs">
                  <% chain.contracts.first(3).each do |contract| %>
                    <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-200"><%= contract.name %></span>
                  <% end %>
                  <% if chain.contracts.length > 3 %>
                    <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-400">+<%= chain.contracts.length - 3 %></span>
                  <% end %>
                </div>

                <% developer_links = [
                  [t("chains.index.tab_docs"), chain.docs_url],
                  [t("chains.index.testnet_guide_explorer"), chain.explorer_url],
                  [t("chains.index.testnet_guide_faucet"), chain.faucet_url],
                  [t("chains.index.testnet_guide_verify"), chain.verify_url]
                ].select { |_, url| url.present? } %>
                <% if developer_links.any? %>
                  <div class="mt-4 flex flex-wrap gap-2">
                    <% developer_links.each do |label, url| %>
                      <a
                        href="<%= url %>"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-slate-200 transition-colors hover:border-sky-400/40 hover:bg-sky-400/10 hover:text-white"
                      >
                        <%= label %>
                        <span aria-hidden="true">↗</span>
                      </a>
                    <% end %>
                  </div>
                <% end %>

                <% if chain.docs_url.present? %>
                  <div class="mt-4 flex items-center justify-between gap-3 text-xs text-slate-500">
                    <span><%= t("chains.index.docs_link") %> <%= chain.docs_url.sub(%r{\Ahttps?://}, "").split("/").first %></span>
                    <span class="flex items-center gap-2">
                      <span class="font-mono text-sky-300"><%= chain.tier.upcase %></span>
                      <a href="<%= public_chain_markdown_path(chain.slug) %>" class="text-sky-300 underline decoration-sky-400/40 underline-offset-4 hover:text-sky-200">
                        <%= t("chains.index.markdown_link") %>
                      </a>
                    </span>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-3xl border border-dashed border-white/10 bg-slate-900/50 p-6 text-sm text-slate-400">
            <%= t("chains.index.no_results") %>
          </div>
        <% end %>
      </section>
    <% else %>
      <% [
        [t("chains.index.live_heading"), @full_chains, "text-emerald-200", t("chains.index.live_subtitle"), "from-emerald-400/70 via-sky-400/70 to-cyan-400/30"],
        [t("chains.index.docs_heading"), @docs_only_chains, "text-amber-200", t("chains.index.docs_subtitle"), "from-amber-400/70 via-orange-400/70 to-rose-400/30"]
      ].each do |heading, chains, heading_class, subtitle, accent| %>
        <section class="mt-12">
          <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
            <div>
              <h2 class="text-xs font-semibold uppercase tracking-[0.35em] <%= heading_class %>"><%= heading %></h2>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400"><%= subtitle %></p>
            </div>
            <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs text-slate-400">
              <%= chains.length %> <%= t("chains.index.stat_visible") %>
            </div>
          </div>

          <% if chains.any? %>
            <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
              <% chains.each do |chain| %>
                <div class="group relative overflow-hidden rounded-[1.75rem] border border-white/10 bg-slate-900/75 p-5 shadow-xl shadow-slate-950/20 transition-all hover:-translate-y-0.5 hover:border-sky-400/40 hover:bg-slate-900/90">
                  <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r <%= accent %> opacity-90"></div>

                  <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.3em] text-slate-300">
                          <%= chain.full? ? t("chains.index.live_pill") : t("chains.index.docs_pill") %>
                        </span>
                        <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.3em] text-slate-300">
                          <%= chain.mainnet? ? t("chains.index.mainnet_pill") : t("chains.index.testnet_pill") %>
                        </span>
                      </div>

                      <h3 class="mt-3 text-xl font-bold text-white transition-colors group-hover:text-sky-300">
                        <a href="<%= public_chain_path(chain.slug) %>" class="hover:text-sky-300"><%= chain.name %></a>
                      </h3>
                      <p class="mt-2 text-sm leading-6 text-slate-400"><%= chain.summary %></p>
                    </div>
                  </div>

                  <div class="mt-5 grid grid-cols-1 gap-3">
                    <div class="rounded-2xl border border-white/10 bg-white/5 p-3">
                      <p class="text-[10px] uppercase tracking-[0.3em] text-slate-500"><%= t("chains.index.metric_chain_id") %></p>
                      <p class="mt-2 font-mono text-lg text-white"><%= chain.chain_id %></p>
                    </div>
                  </div>

                  <div class="mt-4 flex flex-wrap gap-2">
                    <% chain.top_kinds(3).each do |kind, count| %>
                      <span class="rounded-full border border-white/10 bg-slate-950/60 px-3 py-1 text-xs text-slate-200"><%= kind %> <%= count %></span>
                    <% end %>
                  </div>

                  <div class="mt-4 flex flex-wrap gap-2 text-xs">
                    <% chain.contracts.first(3).each do |contract| %>
                      <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-200"><%= contract.name %></span>
                    <% end %>
                    <% if chain.contracts.length > 3 %>
                      <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-400">+<%= chain.contracts.length - 3 %></span>
                    <% end %>
                  </div>

                  <% if chain.docs_url.present? %>
                    <div class="mt-4 flex items-center justify-between gap-3 text-xs text-slate-500">
                      <span><%= t("chains.index.docs_link") %> <%= chain.docs_url.sub(%r{\Ahttps?://}, "").split("/").first %></span>
                      <span class="flex items-center gap-2">
                        <span class="font-mono text-sky-300"><%= chain.tier.upcase %></span>
                        <a href="<%= public_chain_markdown_path(chain.slug) %>" class="text-sky-300 underline decoration-sky-400/40 underline-offset-4 hover:text-sky-200">
                          <%= t("chains.index.markdown_link") %>
                        </a>
                      </span>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="rounded-3xl border border-dashed border-white/10 bg-slate-900/50 p-6 text-sm text-slate-400">
              <%= t("chains.index.no_results") %>
            </div>
          <% end %>
        </section>
      <% end %>
    <% end %>
  </div>
</div>
