<% seo_meta title: "Articles", description: "Published Smarts articles." %>

<div class="mx-auto max-w-4xl py-14 sm:py-20">
  <header class="mb-10">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gray-500">Articles</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-gray-950 sm:text-6xl">Published articles</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-gray-600">
      A lightweight index of the latest Smarts posts.
    </p>
  </header>

  <% if @articles.any? %>
    <div class="space-y-4">
      <% @articles.each do |article| %>
        <% title = article.title_for("en") || article.title_for(article.available_locales.first) %>
        <% summary = article.summary_for("en") || article.summary_for(article.available_locales.first) %>
        <%= link_to article_path(article.slug), class: "block rounded-2xl border border-gray-200 bg-white p-6 transition-colors hover:border-gray-400" do %>
          <div class="flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-[0.18em] text-gray-500">
            <span><%= article_category_label(article) %></span>
            <% if article.published_at.present? %>
              <span class="text-gray-300">/</span>
              <time datetime="<%= article.published_at.utc.iso8601 %>"><%= article.published_at.to_date.to_fs(:long) %></time>
            <% end %>
          </div>
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-gray-950"><%= title %></h2>
          <% if summary.present? %>
            <p class="mt-3 text-base leading-7 text-gray-600"><%= summary %></p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">No published articles yet.</p>
  <% end %>
</div>
