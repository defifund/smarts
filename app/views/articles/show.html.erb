<% seo_meta title: @title, description: @summary, canonical: "#{SeoHelper::SITE_URL}#{@canonical_path}", og_type: "article" %>

<div class="flex gap-8">
  <article class="mx-auto max-w-3xl flex-1 py-14 sm:py-20">
  <header class="mb-12">
    <div class="mb-5 flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-[0.18em] text-gray-500">
      <span><%= article_category_label(@article) %></span>
      <% if @article.published_at.present? %>
        <span class="text-gray-300">/</span>
        <time datetime="<%= @article.published_at.utc.iso8601 %>"><%= @article.published_at.to_date.to_fs(:long) %></time>
      <% end %>
    </div>

    <h1 class="text-4xl font-extrabold tracking-tight text-gray-950 sm:text-6xl"><%= @title %></h1>

    <% if @summary.present? %>
      <p class="mt-6 text-xl leading-8 text-gray-600"><%= @summary %></p>
    <% end %>
  </header>

  <div class="space-y-6 text-lg leading-8 text-gray-700
              [&_a]:font-medium [&_a]:text-blue-700 [&_a]:underline [&_a]:underline-offset-4
              [&_blockquote]:border-l-4 [&_blockquote]:border-gray-300 [&_blockquote]:pl-5 [&_blockquote]:italic [&_blockquote]:text-gray-600
              [&_code]:rounded [&_code]:bg-gray-100 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-[0.9em] [&_code]:text-gray-950
              [&_h2]:mt-12 [&_h2]:text-3xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:text-gray-950
              [&_h3]:mt-10 [&_h3]:text-2xl [&_h3]:font-bold [&_h3]:tracking-tight [&_h3]:text-gray-950
              [&_hr]:my-10 [&_hr]:border-gray-200
              [&_pre]:overflow-x-auto [&_pre]:rounded-2xl [&_pre]:bg-gray-950 [&_pre]:p-5 [&_pre]:text-sm [&_pre]:leading-6 [&_pre]:text-gray-100
              [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:text-gray-100
              [&_table]:min-w-full [&_table]:text-left [&_table]:text-sm
              [&_td]:border-t [&_td]:border-gray-200 [&_td]:px-4 [&_td]:py-3
              [&_th]:px-4 [&_th]:py-3 [&_th]:font-semibold [&_th]:text-gray-950
              [&_ul]:list-disc [&_ul]:pl-6
              [&_ol]:list-decimal [&_ol]:pl-6">
    <%= render_article_markdown(@content) %>
  </div>
  </article>

  <% if @article_headers.present? %>
    <aside class="hidden xl:block w-56 py-14 pl-8 flex-shrink-0">
      <div class="sticky top-20">
        <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-6">On this page</h3>
        <div class="border-l border-gray-200 pl-4">
          <%= render_table_of_contents %>
        </div>
      </div>
    </aside>
  <% end %>
</div>
