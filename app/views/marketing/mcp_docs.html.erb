<% seo_meta(
  title: "Connect your AI",
  description: "One MCP endpoint, every verified smart contract. Set up Claude Code, Claude Desktop, Cursor, Windsurf, or Cline in one line — no API keys, no scraping."
) %>

<div class="flex flex-col items-center w-full min-h-screen bg-gray-950 text-gray-100 fixed inset-0 z-50 overflow-auto">
  <%# ---------- Hero ---------- %>
  <div class="w-full max-w-4xl px-6 pt-20 pb-10 text-center">
    <p class="text-xs uppercase tracking-widest text-blue-400 mb-4">Model Context Protocol</p>
    <h1 class="text-5xl md:text-6xl font-extrabold text-white tracking-tight mb-5">
      Point your AI at smarts.md
    </h1>
    <p class="text-lg md:text-xl text-gray-300 mb-10 max-w-2xl mx-auto">
      One endpoint. Every verified smart contract. Live on-chain data your agent can query —
      no API keys, no scraping.
    </p>

    <div class="bg-gray-900/60 border border-gray-800 rounded-xl p-5 inline-flex items-center gap-4 font-mono text-sm md:text-base">
      <span class="text-gray-500">→</span>
      <code class="text-white break-all"><%= @endpoint_url %></code>
      <button
        type="button"
        data-controller="copy"
        data-copy-text-value="<%= @endpoint_url %>"
        data-action="click->copy#write"
        class="text-xs px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white rounded-lg transition-colors"
        title="Copy endpoint URL"
      >Copy</button>
    </div>
  </div>

  <%# ---------- Install ---------- %>
  <section class="w-full max-w-5xl px-6 pb-14">
    <h2 class="text-xs uppercase tracking-wider text-gray-400 mb-4 font-semibold">Quick install</h2>

    <%# Featured: Claude Code one-liner %>
    <% claude_code_cmd = "claude mcp add --transport http smarts #{@endpoint_url}" %>
    <div class="mb-4 p-5 md:p-6 bg-gradient-to-br from-blue-950/40 via-gray-900/60 to-gray-900/60 border border-blue-900/50 rounded-xl">
      <div class="flex items-baseline justify-between gap-3 mb-3 flex-wrap">
        <div class="flex items-baseline gap-2">
          <span class="text-lg font-bold text-white">Claude Code</span>
          <span class="text-xs text-blue-300/80">Recommended · one command</span>
        </div>
        <span class="text-[11px] text-gray-500 font-mono uppercase tracking-wider">CLI</span>
      </div>
      <div class="relative group">
        <pre class="bg-gray-950 border border-gray-800 rounded-lg pl-4 pr-24 py-3 text-sm overflow-x-auto"><code class="text-gray-100 font-mono whitespace-pre"><%= claude_code_cmd %></code></pre>
        <button
          type="button"
          data-controller="copy"
          data-copy-text-value="<%= claude_code_cmd %>"
          data-action="click->copy#write"
          class="absolute top-2 right-2 text-xs px-2.5 py-1 bg-gray-800/80 hover:bg-blue-600 text-gray-200 hover:text-white rounded-md transition-colors border border-gray-700/60"
        >Copy</button>
      </div>
    </div>

    <%# Other clients — uniform 2×2 grid %>
    <%
      other_clients = [
        {
          name: "Cursor",
          path: "~/.cursor/mcp.json",
          lang: "json",
          pre_class: "md:h-[140px]",
          snippet: %({ "mcpServers": { "smarts": { "url": "#{@endpoint_url}" } } }),
        },
        {
          name: "Codex",
          path: "~/.codex/config.toml",
          lang: "toml",
          pre_class: "md:h-[140px]",
          snippet: <<~TOML.strip
            [mcp_servers.smarts]
            url = "#{@endpoint_url}"
          TOML
        },
        {
          name: "Claude Desktop",
          path: "claude_desktop_config.json",
          lang: "json",
          pre_class: "md:h-[180px]",
          snippet: %({ "mcpServers": { "smarts": { "command": "npx", "args": ["-y", "mcp-remote", "#{@endpoint_url}"] } } }),
          note: 'Uses <code class="text-gray-400">mcp-remote</code> to bridge Streamable HTTP → stdio.'
        },
        {
          name: "Windsurf · Cline · others",
          path: "any MCP client",
          lang: "url",
          pre_class: "md:h-[140px]",
          snippet: @endpoint_url,
          note: "Check the client's MCP docs for exact config syntax — the URL is what matters."
        }
      ]
    %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
      <% other_clients.each do |client| %>
        <div class="p-5 bg-gray-900/60 border border-gray-800 rounded-xl hover:border-gray-700 transition-colors md:h-[240px] md:flex md:flex-col">
          <div class="flex items-baseline justify-between gap-2 mb-3">
            <span class="text-base font-bold text-white"><%= client[:name] %></span>
            <span class="text-[11px] text-gray-500 font-mono truncate"><%= client[:path] %></span>
          </div>
          <div class="relative flex-1">
            <pre class="bg-gray-950 border border-gray-800 rounded-md pl-3 pr-16 py-2.5 text-xs overflow-x-auto leading-relaxed <%= client[:pre_class] %>"><code class="text-gray-200 font-mono whitespace-pre"><%= client[:snippet] %></code></pre>
            <button
              type="button"
              data-controller="copy"
              data-copy-text-value="<%= client[:snippet] %>"
              data-action="click->copy#write"
              class="absolute top-1.5 right-1.5 text-[11px] px-2 py-0.5 bg-gray-800/80 hover:bg-blue-600 text-gray-300 hover:text-white rounded transition-colors border border-gray-700/60"
            >Copy</button>
          </div>
          <% if client[:note] %>
            <p class="text-xs text-gray-500 mt-3 leading-snug"><%= client[:note].html_safe %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <%# ---------- Example queries ---------- %>
  <section class="w-full max-w-5xl px-6 pb-14">
    <h2 class="text-xs uppercase tracking-wider text-gray-400 mb-4 font-semibold">Ask your AI</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
      <% @example_queries.each do |ex| %>
        <div class="p-4 bg-gray-900/60 border border-gray-800 rounded-xl">
          <p class="text-sm text-gray-200 italic leading-snug mb-2 break-words [overflow-wrap:anywhere]">“<%= ex[:q] %>”</p>
          <p class="text-xs text-gray-500 font-mono">→ <%= ex[:tool] %></p>
        </div>
      <% end %>
    </div>
  </section>

  <%# ---------- On-chain native positioning ---------- %>
  <section class="w-full max-w-5xl px-6 pb-14">
    <h2 class="text-xs uppercase tracking-wider text-gray-400 mb-4 font-semibold">On-chain native</h2>

    <div class="p-5 bg-gray-900/60 border border-gray-800 rounded-xl">
      <p class="text-sm text-gray-300 leading-relaxed max-w-3xl">
        Smarts does not stop at API metadata. Your AI can verify contract state, decoded events,
        governance changes, and Polymarket resolution payouts directly from chain data, then compare
        that evidence with off-chain market status when useful.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-5">
        <div class="text-sm text-gray-400">Audit how a Polymarket market resolved on-chain.</div>
        <div class="text-sm text-gray-400">Ask who can pause, upgrade, or change roles on a contract.</div>
        <div class="text-sm text-gray-400">Check whether a condition has a final payout vector.</div>
      </div>
    </div>
  </section>

  <%# ---------- Tool list ---------- %>
  <section class="w-full max-w-5xl px-6 pb-14">
    <h2 class="text-xs uppercase tracking-wider text-gray-400 mb-4 font-semibold">Tools</h2>

    <div class="divide-y divide-gray-800 border border-gray-800 rounded-xl overflow-hidden">
      <% @tools.each do |tool| %>
        <div class="p-4 bg-gray-900/40">
          <code class="text-white font-mono text-sm"><%= tool[:name] %></code>
          <p class="text-sm text-gray-400 mt-1 leading-snug"><%= tool[:blurb] %></p>
        </div>
      <% end %>
    </div>
  </section>

  <%# ---------- Curated shortcuts ---------- %>
  <section class="w-full max-w-5xl px-6 pb-14">
    <h2 class="text-xs uppercase tracking-wider text-gray-400 mb-4 font-semibold">Curated shortcuts</h2>

    <p class="text-sm text-gray-400 mb-4 max-w-3xl">
      Use slugs anywhere a tool accepts <code class="text-gray-300">slug</code>. They resolve to curated blue-chip contracts without copying chain IDs or hex addresses.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
      <% @shortcuts.each do |shortcut| %>
        <div class="p-4 bg-gray-900/60 border border-gray-800 rounded-xl">
          <code class="text-white font-mono text-sm"><%= shortcut[:slug] %></code>
          <p class="text-xs text-gray-500 mt-2 leading-snug"><%= shortcut[:blurb] %></p>
        </div>
      <% end %>
    </div>
  </section>

  <%# ---------- Footer ---------- %>
  <footer class="w-full max-w-5xl px-6 pb-8 flex flex-wrap items-center justify-between gap-4 text-xs text-gray-500">
    <div>
      <a href="https://smarts.md/" class="text-gray-400 hover:text-white underline">smarts.md</a>
      · Built on the <a href="https://modelcontextprotocol.io" target="_blank" rel="noopener" class="hover:text-white underline">MCP spec</a>
    </div>
    <div>
      Built by <a href="https://chain.dev" class="text-gray-400 hover:text-white underline">chain.dev</a>
    </div>
  </footer>
</div>
