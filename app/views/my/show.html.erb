<% seo_meta title: "My account", description: "Manage account connections and admin tools." %>

<section class="py-10 sm:py-14">
  <div class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-gray-500">Account</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-gray-950">My</h1>
    <p class="mt-3 max-w-2xl text-gray-600">
      Manage your publishing accounts and, if you have admin access, open the article admin and jobs dashboard.
    </p>
  </div>

  <% if notice = flash[:notice] %>
    <p class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800"><%= notice %></p>
  <% end %>
  <% if alert = flash[:alert] %>
    <p class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= alert %></p>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-[1.3fr_0.9fr]">
    <div class="rounded-2xl border border-gray-200 bg-white p-5">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h2 class="text-xl font-bold tracking-tight text-gray-950">X accounts</h2>
          <p class="mt-1 text-sm text-gray-600">One account per locale for article distribution.</p>
        </div>
        <%= link_to "Manage", accounts_path, class: "rounded-lg border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-800 hover:border-gray-950 hover:text-gray-950" %>
      </div>

      <div class="mt-5 space-y-3">
        <% Article::SUPPORTED_LOCALES.each do |locale| %>
          <% account = @accounts.find { |item| item.provider == "x" && item.locale == locale } %>
          <div class="flex flex-col gap-4 rounded-xl border border-gray-200 px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-4">
              <span class="rounded-full bg-gray-100 px-3 py-1 font-mono text-xs font-semibold uppercase text-gray-600"><%= locale %></span>
              <div>
                <% if account %>
                  <p class="font-semibold text-gray-950"><%= account.handle %></p>
                  <p class="text-xs font-medium text-emerald-700">Connected</p>
                <% else %>
                  <p class="font-semibold text-gray-950">No X account</p>
                  <p class="text-xs text-gray-500">Tweets for this locale will be skipped until connected.</p>
                <% end %>
              </div>
            </div>
            <%= link_to(account ? "Reconnect X" : "Connect X", auth_x_path(locale: locale),
              class: "inline-flex items-center justify-center rounded-xl border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-800 hover:border-gray-950 hover:text-gray-950") %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="space-y-6">
      <% if Current.user&.admin? %>
        <div class="rounded-2xl border border-gray-200 bg-white p-5">
          <h2 class="text-xl font-bold tracking-tight text-gray-950">Admin</h2>
          <p class="mt-1 text-sm text-gray-600">Admin-only tools.</p>

          <div class="mt-5 space-y-3">
            <%= link_to "Accounts", accounts_path, class: "block rounded-xl border border-gray-300 px-4 py-3 text-sm font-semibold text-gray-800 hover:border-gray-950 hover:text-gray-950" %>
            <%= link_to "Article admin", admin_articles_path, class: "block rounded-xl border border-gray-300 px-4 py-3 text-sm font-semibold text-gray-800 hover:border-gray-950 hover:text-gray-950" %>
            <%= link_to "Jobs", "/jobs", class: "block rounded-xl border border-gray-300 px-4 py-3 text-sm font-semibold text-gray-800 hover:border-gray-950 hover:text-gray-950" %>
          </div>
        </div>
      <% end %>

      <div class="rounded-2xl border border-gray-200 bg-white p-5">
        <h2 class="text-xl font-bold tracking-tight text-gray-950">Session</h2>
        <p class="mt-1 text-sm text-gray-600">End the current session on this device.</p>
        <div class="mt-5">
          <%= button_to "Sign out", session_path, method: :delete, class: "rounded-xl bg-gray-950 px-4 py-2.5 text-sm font-semibold text-white hover:bg-gray-800" %>
        </div>
      </div>
    </div>
  </div>
</section>
